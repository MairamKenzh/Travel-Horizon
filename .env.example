# Copy this file to .env.local (or .env) and fill it in. Never commit those files.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# The public key: "anon" or "publishable"
SUPABASE_ANON_KEY=
# The secret key: "service_role" or "secret". Server only!
SUPABASE_SERVICE_KEY=

# Telegram: bot token from @BotFather, and the chat that receives requests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
